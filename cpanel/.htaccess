Options -Indexes
RewriteEngine On

# فیش و فایل خصوصی مستقیم از وب باز نشود
RewriteRule ^uploads/receipts(/|$) - [F]
RewriteRule ^storage(/|$) - [F]
RewriteRule ^(config\.php|config\.sample\.php)$ - [F]
RewriteRule \.(env|sql|log|bak|old)$ - [F]

# Always revalidate call scripts while the call-engine selector is active.
<IfModule mod_headers.c>
  <FilesMatch "^video-call-(lobby|lobby-selector|livekit-bridge|livekit-bridge-v2|livekit-bridge-v3|watch)\.js$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

# Patient answers normally go to the selected standalone engine. When the
# legacy router marks the request with legacy=1, do not redirect it back again.
RewriteCond %{QUERY_STRING} !(^|&)legacy=1(&|$) [NC]
RewriteCond %{QUERY_STRING} (^|&)answer=1(&|$) [NC]
RewriteCond %{QUERY_STRING} (^|&)room=[^&]+ [NC]
RewriteRule ^video-call/?$ /video-call-live?%{QUERY_STRING} [R=302,L,NE]

# Keep both proven engines untouched. This tiny selector chooses which existing
# lobby controller is loaded for each new call.
RewriteRule ^assets/js/video-call-lobby-legacy\.js$ assets/js/video-call-lobby.js [END]
RewriteRule ^assets/js/video-call-lobby\.js$ assets/js/video-call-lobby-selector.js [END]

# Admin-only call engine control and read-only selector endpoint.
RewriteRule ^admin/video-call-engine/?$ admin-video-call-engine.php [END]
RewriteRule ^video-call-engine-mode/?$ video-call-engine-mode.php [END]

# Call endpoints. /video-call-v2 remains a direct LiveKit diagnostic route;
# /video-call-live follows the admin-selected engine.
RewriteRule ^video-call-v2/?$ livekit-v2.php [END]
RewriteRule ^video-call-live/?$ video-call-entry.php [END]
RewriteRule ^video-call-embed/?$ livekit-embed.php [END]
RewriteRule ^livekit-token/?$ livekit-token-v2.php [END]

# فایل‌های PHP به‌جز index.php مستقیم اجرا نشوند
RewriteCond %{REQUEST_FILENAME} -f
RewriteCond %{REQUEST_URI} !/index\.php$ [NC]
RewriteRule \.php$ - [F]

# اگر فایل/پوشه واقعی بود، همان را سرو کن
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# بقیه درخواست‌ها به index.php
RewriteRule ^ index.php [L]
