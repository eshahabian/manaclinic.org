Options -Indexes
RewriteEngine On

# فیش و فایل خصوصی مستقیم از وب باز نشود
RewriteRule ^uploads/receipts(/|$) - [F]
RewriteRule ^storage(/|$) - [F]
RewriteRule ^(config\.php|config\.sample\.php)$ - [F]
RewriteRule \.(env|sql|log|bak|old)$ - [F]

# Keep the original lobby UI but route the actual media call to the standalone
# LiveKit page. The legacy script stays available to the bridge for UI actions.
RewriteRule ^assets/js/video-call-lobby-legacy\.js$ assets/js/video-call-lobby.js [END]
RewriteRule ^assets/js/video-call-lobby\.js$ assets/js/video-call-livekit-bridge.js [END]

# LiveKit endpoints.
RewriteRule ^video-call-v2/?$ livekit-v2.php [END]
RewriteRule ^video-call-live/?$ livekit-v2.php [END]
RewriteRule ^video-call-embed/?$ livekit-embed.php [END]
RewriteRule ^livekit-token/?$ livekit-token-v2.php [END]

# فایل‌های PHP به‌جز index.php مستقیم اجرا نشوند
RewriteCond %{REQUEST_FILENAME} -f
RewriteCond %{REQUEST_URI} !/index\.php$ [NC]
RewriteRule \.php$ - [F]

# اگر فایل/پوشه واقعی بود، همان را سرو کن
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# بقیه درخواست‌ها به index.php
RewriteRule ^ index.php [L]
