Options -Indexes
RewriteEngine On

# Canonical host: https://manaclinic.org (no www)
RewriteCond %{HTTP_HOST} ^www\.manaclinic\.org$ [NC]
RewriteRule ^ https://manaclinic.org%{REQUEST_URI} [R=301,L]

# Force HTTPS when the origin request was plain HTTP (respect reverse-proxy)
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# فیش و فایل خصوصی مستقیم از وب باز نشود
RewriteRule ^uploads/receipts(/|$) - [F]
RewriteRule ^storage(/|$) - [F]
RewriteRule ^(config\.php|config\.sample\.php)$ - [F]
RewriteRule \.(env|sql|log|bak|old)$ - [F]

# Always revalidate call scripts while the LiveKit migration is active.
<IfModule mod_headers.c>
  <FilesMatch "^video-call-(lobby|livekit-bridge|livekit-bridge-v2|livekit-bridge-v3|watch)\.js$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

# A patient answer used to land on the legacy /video-call renderer first, which
# caused the white mobile screen and required a second Answer click. Bypass that
# renderer completely and preserve the room/media query in the standalone call.
RewriteCond %{QUERY_STRING} (^|&)answer=1(&|$) [NC]
RewriteCond %{QUERY_STRING} (^|&)room=[^&]+ [NC]
RewriteRule ^video-call/?$ /video-call-live?%{QUERY_STRING} [R=302,L,NE]

# Preserve the original lobby UI. Therapist media opens inside the workspace;
# patient answers still use the standalone LiveKit page.
RewriteRule ^assets/js/video-call-lobby-legacy\.js$ assets/js/video-call-lobby.js [END]
RewriteRule ^assets/js/video-call-lobby\.js$ assets/js/video-call-livekit-bridge-v3.js [END]

# LiveKit endpoints.
RewriteRule ^video-call-v2/?$ livekit-v2.php [END]
RewriteRule ^video-call-live/?$ livekit-v2.php [END]
RewriteRule ^video-call-embed/?$ livekit-embed.php [END]
RewriteRule ^livekit-token/?$ livekit-token-v2.php [END]

# فایل‌های PHP به‌جز index.php مستقیم اجرا نشوند
RewriteCond %{REQUEST_FILENAME} -f
RewriteCond %{REQUEST_URI} !/index\.php$ [NC]
RewriteRule \.php$ - [F]

# اگر فایل/پوشه واقعی بود، همان را سرو کن
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# بقیه درخواست‌ها به index.php
RewriteRule ^ index.php [L]
