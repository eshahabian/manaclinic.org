{"openapi": "3.0.4", "info": {"title": "Haya.SMSPanel.RESTfulAPI", "version": "1.0"}, "paths": {"/api/v1/SMS/Send": {"post": {"tags": ["SMS"], "summary": "ارسال تکی ، ارسال گروهی و ارسال متناظر ", "description": "توجه داشته باشید که بر اساس نوع ارسال مدل را بفرستید ، مدل های ارسالی از سمت کاربر رو میتوانید توی داکیومنت مشاهده کنید", "parameters": [{"name": "smsRequest", "in": "query", "schema": {"$ref": "#/components/schemas/ISMSRequest"}}], "responses": {"200": {"description": "OK"}}}}, "/api/v1/SMS/SmartOTP": {"post": {"tags": ["SMS"], "summary": " ارسال otp بصورت هوشمند", "description": "این نوع ارسال فرستنده ندارد و حتما برای این نوع ارسال کاربر باید حداقل 2 عدد خط otp داشته باشد.", "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/SmartOTPRequestModel"}}, "text/json": {"schema": {"$ref": "#/components/schemas/SmartOTPRequestModel"}}, "application/*+json": {"schema": {"$ref": "#/components/schemas/SmartOTPRequestModel"}}}}, "responses": {"200": {"description": "OK"}}}}, "/api/v1/SMS/GetCredit": {"get": {"tags": ["SMS"], "summary": "اعلام موجودی", "description": "موجودی کاربر بر اساس ریال اعلام میگردد", "responses": {"200": {"description": "OK"}}}}, "/api/v1/SMS/Delivery/{refId}": {"get": {"tags": ["SMS"], "summary": "وضعیت پیامک ارسالی", "description": "حداقل 2 ساعت از ارسال پیامک باید گذشته باشد", "parameters": [{"name": "refId", "in": "path", "required": true, "schema": {"type": "integer", "format": "int64"}}], "responses": {"200": {"description": "OK"}}}}, "/api/v1/WebEngageSMS/Send": {"post": {"tags": ["WebEngageSMS"], "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/WebEngageSendRequestModel"}}, "text/json": {"schema": {"$ref": "#/components/schemas/WebEngageSendRequestModel"}}, "application/*+json": {"schema": {"$ref": "#/components/schemas/WebEngageSendRequestModel"}}}}, "responses": {"200": {"description": "OK"}}}}}, "components": {"schemas": {"Custom": {"type": "object", "properties": {"key1": {"type": "string", "nullable": true}, "key2": {"type": "string", "nullable": true}}, "additionalProperties": false}, "ISMSRequest": {"type": "object", "additionalProperties": false}, "Metadata": {"type": "object", "properties": {"campaignType": {"type": "string", "nullable": true}, "timestamp": {"type": "string", "nullable": true}, "messageId": {"type": "string", "nullable": true}, "custom": {"$ref": "#/components/schemas/Custom"}}, "additionalProperties": false}, "SmartOTPRequestModel": {"type": "object", "properties": {"otpSender": {"type": "string", "nullable": true}, "toNumber": {"type": "string", "nullable": true}, "content": {"type": "string", "nullable": true}}, "additionalProperties": false}, "SmsData": {"required": ["body", "fromNumber", "toNumber"], "type": "object", "properties": {"toNumber": {"minLength": 1, "type": "string"}, "fromNumber": {"minLength": 1, "type": "string"}, "body": {"minLength": 1, "type": "string"}}, "additionalProperties": false}, "WebEngageSendRequestModel": {"type": "object", "properties": {"version": {"type": "string", "nullable": true}, "smsData": {"$ref": "#/components/schemas/SmsData"}, "metadata": {"$ref": "#/components/schemas/Metadata"}}, "additionalProperties": false}}, "securitySchemes": {"ApiKey": {"type": "apiKey", "description": "Enter your API key", "name": "x-api-key", "in": "header"}}}, "security": [{"ApiKey": []}], "tags": [{"name": "SMS", "description": "ارسال پیامک ، دریافت اعتبار و دریافت وضعیت پیامک ارسالی"}]}