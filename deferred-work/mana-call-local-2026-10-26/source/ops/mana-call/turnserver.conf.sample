# Install only on the website's own domestically reachable server.
# Replace placeholders privately; do not commit the resulting secret.
listening-port=3478
tls-listening-port=5349
min-port=49160
max-port=49260
realm=manaclinic.org
server-name=turn.manaclinic.org
fingerprint
use-auth-secret
static-auth-secret=REPLACE_WITH_THE_SAME_RANDOM_SECRET_AS_CONFIG_CALL_LOCAL
cert=/etc/letsencrypt/live/turn.manaclinic.org/fullchain.pem
pkey=/etc/letsencrypt/live/turn.manaclinic.org/privkey.pem
# If this machine is behind NAT, configure external-ip=PUBLIC_IP/PRIVATE_IP
# and forward both listeners and the entire relay port range above.
no-cli
no-multicast-peers
no-tcp-relay
no-tlsv1
no-tlsv1_1
# Do not allow authenticated website users to relay into private services.
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=::1
denied-peer-ip=fc00::-fdff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fe80::-febf:ffff:ffff:ffff:ffff:ffff:ffff:ffff
